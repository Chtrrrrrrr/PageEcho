{
  "manifest_version": 3,
  "name": "PageEcho · 页面回声",
  "version": "1.0.0",
  "description": "在任意网页留下一句话。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PageEcho · 页面回声",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/manager/manager.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "scripts": [
      "src/core/ext.js",
      "src/core/util.js",
      "src/core/schema.js",
      "src/core/matcher.js",
      "src/core/bg.js",
      "src/background/service-worker.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "src/core/ext.js",
        "src/core/util.js",
        "src/core/schema.js",
        "src/core/matcher.js",
        "src/core/store.js",
        "src/ui/styles.js",
        "src/ui/components.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "contextMenus", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "commands": {
    "open-composer": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "为当前页面留话给未来"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pageecho@local.extension",
      "strict_min_version": "115.0"
    }
  }
}
